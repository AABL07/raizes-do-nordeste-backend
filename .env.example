# Banco de dados
DB_URL=jdbc:postgresql://localhost:5432/raizes_do_nordeste
DB_USERNAME=raizes_app
DB_PASSWORD=troque_esta_senha

# JWT
# Utilize uma chave segura. Para desenvolvimento, recomenda-se gerar
# ao menos 32 bytes aleatórios e armazená-los em Base64.
JWT_SECRET=substitua_por_uma_chave_base64_segura
JWT_EXPIRATION_MS=3600000git status --short